{
  "vocab": "likelihood",
  "version": "1.0",
  "store": "Store the number (0 to 1) as the source of truth. Show the ICD 203 term with its band. Put the UK term in a tooltip. Kent is for reference only.",
  "boundary_rule": "Band edges overlap in ICD 203 (01-05, 05-20, ...). The kit resolves them symmetrically about 0.5: p < 0.05 almost no chance; 0.05 <= p < 0.20 very unlikely; 0.20 <= p < 0.45 unlikely; 0.45 <= p <= 0.55 roughly even chance; 0.55 < p <= 0.80 likely; 0.80 < p <= 0.95 very likely; p > 0.95 almost certain.",
  "never_with_confidence": "ICD 203 does not allow a likelihood term and a confidence level in the same sentence. Show them as separate chips.",
  "sources": {
    "icd203": "https://archive.dni.gov/files/documents/ICD/ICD-203.pdf",
    "uk": "https://www.gov.uk/government/publications/explaining-uncertainty-in-uk-intelligence-assessment/explaining-uncertainty-in-uk-intelligence-assessment",
    "kent": "https://www.cia.gov/resources/csi/static/Words-of-Estimative-Probability.pdf"
  },
  "verified": "Checked 30 Oct 2026: the operative text is the 2 Jan 2015 directive. The 12 Jun 2023 technical amendment adds annual analyst training only; the likelihood table and the standards are unchanged.",
