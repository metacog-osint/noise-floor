  "lifelines": {
    "toolkit": "FEMA Community Lifelines Implementation Toolkit 2.1 (July 2023)",
    "rule": "A status is a snapshot for one operational period, judged against how the lifeline functions in pre-incident conditions. The suite computes it per place from each program's own baseline.",
    "values": {
      "safety_and_security": { "name": "Safety and Security", "abbr": "SS",
        "components": ["Law Enforcement/Security", "Fire Service", "Search and Rescue", "Government Service", "Community Safety"] },
      "food_hydration_shelter": { "name": "Food, Hydration, Shelter", "abbr": "FHS",
        "components": ["Food", "Hydration", "Shelter", "Agriculture"] },
      "health_and_medical": { "name": "Health and Medical", "abbr": "HM",
        "components": ["Medical Care", "Public Health", "Patient Movement", "Medical Supply Chain", "Fatality Management"] },
      "energy": { "name": "Energy", "abbr": "E",
        "components": ["Power Grid", "Fuel"] },
      "communications": { "name": "Communications", "abbr": "C",
        "components": ["Infrastructure", "Responder Communications", "Alerts, Warnings, and Messages", "Finance", "911 and Dispatch"] },
      "transportation": { "name": "Transportation", "abbr": "T",
        "components": ["Highway/Roadway/Motor Vehicle", "Mass Transit", "Railway", "Aviation", "Maritime"] },
      "hazardous_materials": { "name": "Hazardous Materials", "abbr": "HZ",
        "components": ["Facilities", "HAZMAT, Pollutants, Contaminants"] },
      "water_systems": { "name": "Water Systems", "abbr": "W",
        "components": ["Potable Water Infrastructure", "Wastewater Management"] }
    },
    "status": {
      "unknown":     { "term": "Unknown", "letter": "U",  "rgb": [145, 147, 149], "hex": "#919395", "meaning": "Extent of disruption unknown. Also used when the suite has no data." },
      "significant": { "term": "Significant impact", "letter": "S", "rgb": [197, 32, 56], "hex": "#C52038", "meaning": "Severe challenges hindering essential services." },
      "moderate":    { "term": "Moderate impact", "letter": "M", "rgb": [251, 186, 22], "hex": "#FBBA16", "meaning": "Disruption to normal pre-incident service; restoration in progress or by temporary means." },
      "minimal":     { "term": "Minimal impact", "letter": "OK", "rgb": [94, 156, 66], "hex": "#5E9C42", "meaning": "Functioning at pre-incident levels, minor disruptions only." },
      "baseline":    { "term": "Administrative / pre-incident", "letter": "B", "rgb": [1, 82, 135], "hex": "#015287", "meaning": "Not an operational status; pre-incident state or no incident." }
    },
    "contrast_note": "FEMA yellow on white is 1.73:1 and FEMA blue on a dark background is 2.25:1; draw outlines or halos and always print the letter."
  },
