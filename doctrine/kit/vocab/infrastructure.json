  "note": "CISA's National Critical Functions are borrowed as a functional taxonomy for events anywhere in the world, not as a claim of US criticality. CISA publishes no function-to-sector or function-to-lifeline crosswalk; the sectors[] and lifelines[] on each function below are this suite's own judgment, published so others can check it.",
  "sources": {
    "ncf_set": "https://www.cisa.gov/sites/default/files/publications/national-critical-functions-set-508.pdf",
    "ncf_page": "https://www.cisa.gov/topics/risk-management/national-critical-functions",
    "sectors": "https://www.cisa.gov/topics/critical-infrastructure-security-and-resilience/critical-infrastructure-sectors",
    "lifelines_toolkit_2_1": "https://www.fema.gov/emergency-managers/practitioners/lifelines"
  },
  "sectors": {
    "chemical": "Chemical",
    "commercial_facilities": "Commercial Facilities",
    "communications": "Communications",
