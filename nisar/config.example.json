{
  "_about": "Copy to private/watch/nisar.json (gitignored) and set your own area there. The area below is the public Shiraz validation box, used only as an example.",
  "aoi": {
    "name": "Example area",
    "bbox": [51.6, 26.4, 54.2, 28.3]
  },
  "collections": ["NISAR_L2_GCOV_PROVISIONAL_V1"],
  "lookback_days": 10,
  "max_granules_per_run": 40,
  "keep_days": 60,
  "cell_m": 500,
  "frequencies": ["A", "B"],
  "alert_min_confidence": "MEDIUM",
  "alert_on_quiet": false,
  "detect": {
    "seed_z": 5.0,
    "grow_z": 2.0,
    "min_cells": 4,
    "min_excess_db": 1.5,
    "line_km": 4.5
  },
  "sites": {
    "site_prefix": "S",
    "match_km": 25,
    "quiet_after": 2,
    "fix_min_cross_deg": 20
  },
  "ignore": [],
  "state_dir": "private/nisar/state",
  "out_dir": "private/nisar/out"
}
